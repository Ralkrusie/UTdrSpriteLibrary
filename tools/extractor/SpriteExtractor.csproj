<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed><TrimMode>link</TrimMode><DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization><RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UmtDir>$(MSBuildThisFileDirectory)..\..\vendor\umt\0.9.2.0</UmtDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ExportSource)" />
    <Reference Include="$(UmtDir)\UndertaleModLib.dll" />
    <Reference Include="$(UmtDir)\Underanalyzer.dll" />
    <Reference Include="$(UmtDir)\Newtonsoft.Json.dll" />
    <Reference Include="$(UmtDir)\Magick.NET*.dll" />
    <Reference Include="$(UmtDir)\ICSharpCode.SharpZipLib.dll" />
    <Reference Include="$(UmtDir)\Microsoft.CodeAnalysis*.dll" />
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    <Content Include="$(UmtDir)\Magick.Native-Q8-x64.dll"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
